  "libraries": [],
  "components": [
    {
      "name": "Bracket",
      "group": "Tournoi",
      "summary": "L'arbre de tournoi se dessine en SVG, toujours accompagné d'une vue tableau équivalente."
    },
    {
      "name": "Controls",
      "group": "Contrôles",
      "summary": "Les boutons et champs de saisie Oracup, avec leurs états par défaut, de focus, désactivé et d'erreur."
    },
    {
      "name": "LiveDashboard",
      "group": "Dashboard",
      "summary": "Le dashboard en direct se projette en plein écran dans une salle de LAN, en thème sombre, avec le match en cours, la répartition du public et le classement."
    },
    {
      "name": "Logo",
      "group": "Identité",
      "summary": "Le logo Oracup associe le symbole de la coupe et le nom composé en texte, sur fond clair, sombre ou de marque."
    },
    {
      "name": "MatchCard",
      "group": "Pronostics",
      "summary": "La carte de match permet de pronostiquer un vainqueur, puis affiche le pronostic verrouillé et son résultat."
    },
    {
      "name": "MobileApp",
      "group": "Mobile",
      "summary": "L'écran mobile Pronostics montre le verrouillage imminent, un match en direct, une question Pick'em et la barre d'onglets."
    },
    {
      "name": "StatusBadge",
      "group": "Statuts",
      "summary": "Le badge de statut annonce un état (Juste, Faux, En direct, Verrouillé, À venir) par une icône et un mot, jamais par la couleur seule."
    }
  ],
