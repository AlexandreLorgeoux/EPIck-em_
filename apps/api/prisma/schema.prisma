// Sprint 2 slice of docs/data-model.md. Tables and columns keep the
// snake_case names of the data model so raw SQL and triggers match the doc.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ParticipantKind {
  team
  player

  @@map("participant_kind")
}

enum SourceKind {
  startgg
  manual
  csv
  json

  @@map("source_kind")
}

enum UserRole {
  admin
  player
  spectator

  @@map("user_role")
}

enum TournamentLifecycle {
  draft
  published
  archived

  @@map("tournament_lifecycle")
}

enum TournamentVisibility {
  public
  invite_only

  @@map("tournament_visibility")
}

enum VenueMode {
  online
  onsite
  mixed

  @@map("venue_mode")
}

enum RegistrationMode {
  open
  approval

  @@map("registration_mode")
}

enum TournamentOrigin {
  internal
  imported

  @@map("tournament_origin")
}

enum StageFormat {
  single_elim
  double_elim
  round_robin
  swiss
  ffa

  @@map("stage_format")
}

enum SeedingMode {
  manual
  auto

  @@map("seeding_mode")
}

enum PredictionMode {
  none
  match_by_match
  full_bracket
  both

  @@map("prediction_mode")
}

enum RegistrationStatus {
  pending
  registered
  waitlisted
  checked_in
  withdrawn
  disqualified

  @@map("registration_status")
}

enum FeederKind {
  seed
  match_winner
  match_loser
  stage_rank
  bye

  @@map("feeder_kind")
}

enum OutcomeKind {
  played
  forfeit
  disqualification
  void

  @@map("outcome_kind")
}

enum SlotState {
  open
  assigned
  bye

  @@map("slot_state")
}

enum SlotResolvedFrom {
  seed
  feeder
  bye
  none

  @@map("slot_resolved_from")
}

enum MatchState {
  pending
  decided
  void
  stale
  conflict

  @@map("match_state")
}

// ---------------------------------------------------------------------------
// Setup: configuration chosen by an organizer
// ---------------------------------------------------------------------------

model Game {
  id              String          @id @default(uuid(7)) @db.Uuid
  slug            String          @unique
  name            String
  participantKind ParticipantKind @map("participant_kind")
  maxTeamSize     Int             @map("max_team_size")
  drawAllowed     Boolean         @default(false) @map("draw_allowed")
  externalRef     String?         @map("external_ref")

  tournaments Tournament[]

  @@map("game")
}

model Source {
  id     String     @id @default(uuid(7)) @db.Uuid
  kind   SourceKind
  name   String
  // Non-secret settings only: tokens never go in the database
  config Json       @default("{}")

  tournaments   Tournament[]
  teams         Team[]
  players       Player[]
  registrations Registration[]
  matchResults  MatchResult[]

  @@map("source")
}

model User {
  id           String   @id @default(uuid(7)) @db.Uuid
  email        String   @unique
  displayName  String   @map("display_name")
  // Generated by the simulator: the demo platform holds no real personal data
  isSynthetic  Boolean  @default(false) @map("is_synthetic")
  role         UserRole @default(spectator)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  // argon2id hash; null for accounts that cannot sign in (synthetic users)
  passwordHash String?  @map("password_hash")

  ownedTournaments Tournament[]
  players          Player[]
  reportedResults  MatchResult[]
  sessions         Session[]

  @@map("user")
}

// One signed-in device. The refresh token itself is never stored, only its
// SHA-256 hash, and it changes on every refresh.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent  String?   @map("user_agent")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Tournament {
  id                 String               @id @default(uuid(7)) @db.Uuid
  gameId             String               @map("game_id") @db.Uuid
  ownerUserId        String               @map("owner_user_id") @db.Uuid
  name               String
  slug               String               @unique
  // Live or finished is derived from matches, not stored
  lifecycle          TournamentLifecycle  @default(draft)
  startsAt           DateTime?            @map("starts_at") @db.Timestamptz(6)
  timezone           String               @default("Europe/Paris")
  description        String?
  rulesText          String?              @map("rules_text")
  visibility         TournamentVisibility @default(public)
  venueMode          VenueMode            @default(online) @map("venue_mode")
  venue              String?
  capacity           Int?
  registrationMode   RegistrationMode     @default(open) @map("registration_mode")
  checkinOpensAt     DateTime?            @map("checkin_opens_at") @db.Timestamptz(6)
  checkinClosesAt    DateTime?            @map("checkin_closes_at") @db.Timestamptz(6)
  teamMinStarters    Int                  @default(1) @map("team_min_starters")
  teamMaxStarters    Int                  @default(1) @map("team_max_starters")
  teamMaxSubstitutes Int                  @default(0) @map("team_max_substitutes")
  origin             TournamentOrigin     @default(internal)
  readOnly           Boolean              @default(false) @map("read_only")
  isTemplate         Boolean              @default(false) @map("is_template")
  duplicatedFromId   String?              @map("duplicated_from_id") @db.Uuid
  sourceId           String?              @map("source_id") @db.Uuid
  externalRef        String?              @map("external_ref")

  game           Game           @relation(fields: [gameId], references: [id])
  owner          User           @relation(fields: [ownerUserId], references: [id])
  duplicatedFrom Tournament?    @relation("TournamentDuplicate", fields: [duplicatedFromId], references: [id])
  duplicates     Tournament[]   @relation("TournamentDuplicate")
  source         Source?        @relation(fields: [sourceId], references: [id])
  stages         Stage[]
  registrations  Registration[]

  @@index([gameId])
  @@index([ownerUserId])
  @@map("tournament")
}

model Stage {
  id                String         @id @default(uuid(7)) @db.Uuid
  tournamentId      String         @map("tournament_id") @db.Uuid
  position          Int
  name              String
  format            StageFormat
  // Null for the last stage
  advanceCount      Int?           @map("advance_count")
  seedingMode       SeedingMode    @default(manual) @map("seeding_mode")
  predictionMode    PredictionMode @default(none) @map("prediction_mode")
  // Null means the start of the stage's first match
  predictionLocksAt DateTime?      @map("prediction_locks_at") @db.Timestamptz(6)
  // Format settings: Swiss rounds, third-place match, best-of, points, tie-breaks
  params            Json           @default("{}")

  tournament  Tournament  @relation(fields: [tournamentId], references: [id])
  matches     Match[]
  rankFeeders MatchSlot[] @relation("SlotFeederStage")

  @@unique([tournamentId, position])
  @@map("stage")
}

model Team {
  id              String  @id @default(uuid(7)) @db.Uuid
  name            String
  tag             String?
  captainPlayerId String? @map("captain_player_id") @db.Uuid
  sourceId        String? @map("source_id") @db.Uuid
  externalRef     String? @map("external_ref")

  captain       Player?        @relation("TeamCaptain", fields: [captainPlayerId], references: [id])
  source        Source?        @relation(fields: [sourceId], references: [id])
  members       TeamMember[]
  registrations Registration[]

  @@map("team")
}

model Player {
  id          String  @id @default(uuid(7)) @db.Uuid
  // Null for players who never signed up
  userId      String? @map("user_id") @db.Uuid
  handle      String
  sourceId    String? @map("source_id") @db.Uuid
  externalRef String? @map("external_ref")

  user          User?          @relation(fields: [userId], references: [id])
  source        Source?        @relation(fields: [sourceId], references: [id])
  captainOf     Team[]         @relation("TeamCaptain")
  memberships   TeamMember[]
  registrations Registration[]

  @@index([userId])
  @@map("player")
}

model TeamMember {
  teamId       String    @map("team_id") @db.Uuid
  playerId     String    @map("player_id") @db.Uuid
  joinedOn     DateTime  @map("joined_on") @db.Date
  leftOn       DateTime? @map("left_on") @db.Date
  isSubstitute Boolean   @default(false) @map("is_substitute")
  role         String?

  team   Team   @relation(fields: [teamId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@id([teamId, playerId, joinedOn])
  @@index([playerId])
  @@map("team_member")
}

model Match {
  id               String    @id @default(uuid(7)) @db.Uuid
  stageId          String    @map("stage_id") @db.Uuid
  // Column of the bracket; the Swiss round number for Swiss stages
  bracketRound     Int       @map("bracket_round")
  position         Int
  label            String
  bestOf           Int       @default(1) @map("best_of")
  scheduledAt      DateTime? @map("scheduled_at") @db.Timestamptz(6)
  estimatedMinutes Int?      @map("estimated_minutes")

  stage   Stage         @relation(fields: [stageId], references: [id])
  slots   MatchSlot[]   @relation("MatchSlots")
  feeds   MatchSlot[]   @relation("SlotFeederMatch")
  results MatchResult[]
  outcome MatchOutcome?

  @@unique([stageId, bracketRound, position])
  @@map("match")
}

// Says where a participant comes from; the participant itself is derived
// (SlotAssignment)
model MatchSlot {
  id            String     @id @default(uuid(7)) @db.Uuid
  matchId       String     @map("match_id") @db.Uuid
  position      Int
  feederKind    FeederKind @map("feeder_kind")
  seedNumber    Int?       @map("seed_number")
  feederMatchId String?    @map("feeder_match_id") @db.Uuid
  feederStageId String?    @map("feeder_stage_id") @db.Uuid
  feederRank    Int?       @map("feeder_rank")

  match       Match           @relation("MatchSlots", fields: [matchId], references: [id])
  feederMatch Match?          @relation("SlotFeederMatch", fields: [feederMatchId], references: [id])
  feederStage Stage?          @relation("SlotFeederStage", fields: [feederStageId], references: [id])
  assignment  SlotAssignment?

  @@unique([matchId, position])
  @@index([feederMatchId])
  @@map("match_slot")
}

// ---------------------------------------------------------------------------
// Raw: facts entered or imported. Results are append-only (see migration
// triggers): a correction is a new MatchResult version.
// ---------------------------------------------------------------------------

model Registration {
  id           String             @id @default(uuid(7)) @db.Uuid
  tournamentId String             @map("tournament_id") @db.Uuid
  // Exactly one of team_id and player_id is set (CHECK in the migration)
  teamId       String?            @map("team_id") @db.Uuid
  playerId     String?            @map("player_id") @db.Uuid
  seed         Int?
  status       RegistrationStatus @default(registered)
  checkedInAt  DateTime?          @map("checked_in_at") @db.Timestamptz(6)
  customFields Json               @default("{}") @map("custom_fields")
  sourceId     String?            @map("source_id") @db.Uuid

  tournament      Tournament           @relation(fields: [tournamentId], references: [id])
  team            Team?                @relation(fields: [teamId], references: [id])
  player          Player?              @relation(fields: [playerId], references: [id])
  source          Source?              @relation(fields: [sourceId], references: [id])
  reportedEntries MatchResultEntrant[]
  slotAssignments SlotAssignment[]
  wins            MatchOutcome[]       @relation("OutcomeWinner")
  losses          MatchOutcome[]       @relation("OutcomeLoser")

  @@unique([tournamentId, teamId])
  @@unique([tournamentId, playerId])
  @@map("registration")
}

model MatchResult {
  // Identity: increases with time
  id                 BigInt      @id @default(autoincrement())
  matchId            String      @map("match_id") @db.Uuid
  // The current result of a match is its highest version
  version            Int
  outcomeKind        OutcomeKind @map("outcome_kind")
  declaredWinnerSlot Int?        @map("declared_winner_slot")
  // Required from version 2 (CHECK in the migration)
  reason             String?
  reportedById       String?     @map("reported_by") @db.Uuid
  sourceId           String?     @map("source_id") @db.Uuid
  supersedesId       BigInt?     @unique @map("supersedes_id")
  recordedAt         DateTime    @default(now()) @map("recorded_at") @db.Timestamptz(6)

  match        Match                @relation(fields: [matchId], references: [id])
  reportedBy   User?                @relation(fields: [reportedById], references: [id])
  source       Source?              @relation(fields: [sourceId], references: [id])
  supersedes   MatchResult?         @relation("ResultSupersedes", fields: [supersedesId], references: [id])
  supersededBy MatchResult?         @relation("ResultSupersedes")
  entrants     MatchResultEntrant[]
  rounds       Round[]
  usedBy       MatchOutcome[]

  @@unique([matchId, version])
  @@map("match_result")
}

// Who the reporter says played in each slot, to detect stale results
model MatchResultEntrant {
  matchResultId  BigInt @map("match_result_id")
  slotPosition   Int    @map("slot_position")
  registrationId String @map("registration_id") @db.Uuid

  matchResult  MatchResult  @relation(fields: [matchResultId], references: [id])
  registration Registration @relation(fields: [registrationId], references: [id])

  @@id([matchResultId, slotPosition])
  @@index([registrationId])
  @@map("match_result_entrant")
}

model Round {
  id              String  @id @default(uuid(7)) @db.Uuid
  matchResultId   BigInt  @map("match_result_id")
  number          Int
  // Map, character or mode, if the game has one
  variant         String?
  durationSeconds Int?    @map("duration_seconds")

  matchResult MatchResult  @relation(fields: [matchResultId], references: [id])
  scores      RoundScore[]

  @@unique([matchResultId, number])
  @@map("round")
}

model RoundScore {
  roundId      String @map("round_id") @db.Uuid
  slotPosition Int    @map("slot_position")
  score        Int
  // Rank in the round for an FFA, null for a duel
  placement    Int?

  round Round @relation(fields: [roundId], references: [id])

  @@id([roundId, slotPosition])
  @@map("round_score")
}

// ---------------------------------------------------------------------------
// Derived: written only by the recalculation job (see migration triggers)
// ---------------------------------------------------------------------------

model SlotAssignment {
  matchSlotId    String           @id @map("match_slot_id") @db.Uuid
  // Null while unknown
  registrationId String?          @map("registration_id") @db.Uuid
  state          SlotState
  resolvedFrom   SlotResolvedFrom @map("resolved_from")

  matchSlot    MatchSlot     @relation(fields: [matchSlotId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])

  @@index([registrationId])
  @@map("slot_assignment")
}

model MatchOutcome {
  matchId              String     @id @map("match_id") @db.Uuid
  state                MatchState
  // The MatchResult version used, null if none
  resultId             BigInt?    @map("result_id")
  winnerRegistrationId String?    @map("winner_registration_id") @db.Uuid
  // Always null in an FFA, where MatchPlacement gives the full order
  loserRegistrationId  String?    @map("loser_registration_id") @db.Uuid

  match  Match         @relation(fields: [matchId], references: [id])
  result MatchResult?  @relation(fields: [resultId], references: [id])
  winner Registration? @relation("OutcomeWinner", fields: [winnerRegistrationId], references: [id])
  loser  Registration? @relation("OutcomeLoser", fields: [loserRegistrationId], references: [id])

  @@map("match_outcome")
}
