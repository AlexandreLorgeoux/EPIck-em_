# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer le fichier .env (voir .gitignore).

# --- Application ---
NODE_ENV=development
PORT=3000
API_PORT=4000

# --- Base de données (PostgreSQL) ---
# Utilisée par le backend NestJS et Docker Compose.
DATABASE_URL=postgresql://epickem:epickem@localhost:5432/epickem
POSTGRES_USER=epickem
POSTGRES_PASSWORD=epickem
POSTGRES_DB=epickem

# --- Authentification ---
# Secret utilisé pour signer les sessions / tokens. Générer une valeur
# aléatoire forte en local et en production (ex: openssl rand -hex 32).
AUTH_SECRET=change-me

# --- Connecteur start.gg ---
# Token d'API personnel généré sur https://start.gg/admin/profile/developer
# Nécessaire uniquement pour l'import de tournois externes.
STARTGG_API_TOKEN=

# --- Temps réel ---
# URL du serveur WebSocket/SSE exposée au client web et mobile.
REALTIME_URL=ws://localhost:4000

# --- Application mobile ---
# URL de base de l'API consommée par l'application mobile.
EXPO_PUBLIC_API_URL=http://localhost:4000
