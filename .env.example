# Copier ce fichier en .env et renseigner les valeurs réelles.
# Ne jamais committer le fichier .env (voir .gitignore).

# --- Application ---
NODE_ENV=development
PORT=3000
API_PORT=4000

# --- Base de données (PostgreSQL) ---
# Utilisée par le backend NestJS et Docker Compose.
DATABASE_URL=postgresql://epickem:epickem@localhost:5432/epickem
POSTGRES_USER=epickem
POSTGRES_PASSWORD=epickem
POSTGRES_DB=epickem

# --- Authentification ---
# Secret utilisé pour signer les sessions / tokens. Générer une valeur
# aléatoire forte en local et en production (ex: openssl rand -hex 32).
# Obligatoire : l'API refuse de démarrer sans. L'API avertit au démarrage
# tant que la valeur d'exemple ou une valeur de moins de 32 caractères est
# utilisée.
AUTH_SECRET=change-me

# Premier compte admin, créé au démarrage de l'API s'il n'existe pas encore
# (l'inscription publique ne crée que des spectateurs). Laisser vide pour
# ne rien créer. Mot de passe de 8 caractères minimum.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=Admin

# Facultatif. Tentatives de connexion et d'inscription autorisées par IP et
# par minute (10 par défaut).
# AUTH_RATE_LIMIT=10
# Facultatif. Derrière un proxy (rewrite Next.js, load balancer) : nombre de
# proxys de confiance, pour que la limite s'applique par visiteur.
# TRUST_PROXY=1
# Facultatif. Cookies "Secure" (HTTPS uniquement). Par défaut : activés
# quand NODE_ENV=production.
# COOKIE_SECURE=true

# --- Connecteur start.gg ---
# Token d'API personnel généré sur https://start.gg/admin/profile/developer
# Nécessaire uniquement pour l'import de tournois externes.
STARTGG_API_TOKEN=

# --- Temps réel ---
# URL du serveur WebSocket/SSE exposée au client web et mobile.
REALTIME_URL=ws://localhost:4000

# --- Application mobile ---
# URL de base de l'API consommée par l'application mobile.
EXPO_PUBLIC_API_URL=http://localhost:4000
